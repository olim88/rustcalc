{
	"name": "rust-calc",
	"version": "1.1.0",
	"description": "Latex Evaluator",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"build:wasm": "wasm-pack build rust --target web --out-dir ../pkg",
		"dev": "npm run build:wasm && node esbuild.config.mjs",
		"build": "npm run build:wasm && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@codemirror/language": "^6.11.3",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
